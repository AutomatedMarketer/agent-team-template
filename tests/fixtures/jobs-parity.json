{
  "about": "Shared contract for the jobs snapshot (the Readiness wall: every scheduled job on a Mac and in Hermes, one light each). The same bytes live in agent-team-template and agent-cockpit; a test in each repo checks they match. The collector writes `sample`-shaped files; the board reads them. The Mac works out, in the job's own timezone, the two most recent times each job was expected to run (dueAt, dueBeforeAt) and writes them down - the board never works them out from a schedule it cannot see and says a job is late only when dueAt is there. Names, times, numbers and states only: a job's arguments, environment settings, folders, prompts, error text and logs have no key here, so they cannot reach a file.",
  "schema": "agent-status/jobs/v1",
  "folder": ".agent-team/status/jobs",
  "computerSlug": "^[a-z0-9-]{1,32}$",
  "staleAfterHours": 8,
  "maxFilesRead": 5,
  "maxFileBytes": 65536,
  "maxComputersShown": 3,
  "statuses": [
    "found",
    "not found",
    "unavailable"
  ],
  "caps": {
    "launchd": 60,
    "hermes": 40,
    "slots": 48
  },
  "graceMinutes": 30,
  "lookbackDays": 32,
  "launchdStates": [
    "running",
    "loaded",
    "not loaded"
  ],
  "hermesResults": [
    "ok",
    "error",
    "unknown"
  ],
  "exitCode": {
    "min": -255,
    "max": 255
  },
  "cadence": {
    "kinds": [
      "always",
      "every",
      "slots",
      "unknown"
    ],
    "everyMinutes": { "min": 1, "max": 44640 },
    "slot": {
      "minute": { "min": 0, "max": 59 },
      "hour": { "min": 0, "max": 23 },
      "weekday": { "min": 0, "max": 6 },
      "day": { "min": 1, "max": 31 }
    },
    "slotRule": "A slot is one minute of the hour. With an hour it is one time of day; without, it is every hour. With a weekday (0 is Sunday) it is that day of the week; with a day (1 to 31) that day of the month; with neither, every day. A slot never has both a weekday and a day. Slots are written in order of day, weekday, hour, then minute, a missing value first."
  },
  "names": {
    "label": "^[A-Za-z0-9][A-Za-z0-9._-]{0,59}$",
    "labelRule": "A launchd label, and a Hermes job id, are held to this form and to the connection-name rule from tests/fixtures/connections-parity.json on top (no at sign, slash, backslash, key or token start, uuid, stretch of 24 or more characters without a separator, and not this computer's username, name or home folder). One that fails is not written; it is counted in hidden. A Hermes job name and profile are held to the connection-name rule and Hermes's profile rule as they are.",
    "labelAccept": [
      "local.donna.story-belt-daily",
      "local.donna.agent-status-collector",
      "com.donna.blog-watch",
      "ai.hermes.gateway-donna",
      "com.example.Weekly_Report",
      "a1b2c3d4e5f6",
      "nightly-brief",
      "job_7"
    ],
    "labelRefuse": [
      { "name": "", "why": "empty" },
      { "name": "local.donna@host.job", "why": "an at sign" },
      { "name": "local/donna.job", "why": "a slash" },
      { "name": "local\\donna.job", "why": "a backslash" },
      { "name": ".hidden.job", "why": "does not start with a letter or number" },
      { "name": "local donna job", "why": "a space" },
      { "name": "local.über.job", "why": "a letter a launchd label does not use" },
      { "name": "0f0e0d0c-1111-2222-3333-444455556666", "why": "a uuid" },
      { "name": "local.desk-helper", "why": "contains sk- by accident, refused all the same" },
      { "name": "local.bearer-bot", "why": "an authorization header word" },
      { "name": "local.eyJhbGciOiJIUzI1NiJ9", "why": "the start of a signed token" },
      { "name": "local.abcdefghijklmnopqrstuvwxyz0123", "why": "a stretch of 24 or more characters without a separator" },
      { "name": "local.donna.a-very-long-label-that-keeps-going-past-sixty-characters", "why": "longer than 60 characters" }
    ]
  },
